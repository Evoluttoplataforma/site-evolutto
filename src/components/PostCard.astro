---
import type { Post } from '../lib/blog';
import { readTime } from '../lib/blog';
import BlogCover from './BlogCover.astro';

interface Props { post: Post; }
const { post } = Astro.props;
const { title, category, author } = post.data;
const minutes = readTime(post.body);
---

<a href={`/blog/${post.slug}`} class="blog-card group block">
  <BlogCover
    title={title}
    category={category}
    author={author}
    minutes={minutes}
    size="card"
    headingTag="h3"
  />
</a>
