---
import Site from '../../layouts/Site.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostCard from '../../components/PostCard.astro';
import BlogCover from '../../components/BlogCover.astro';
import { allPosts, categoriesOf, fmtDate, readTime } from '../../lib/blog';

const posts = await allPosts();
const cats = categoriesOf(posts);
const [featured, ...rest] = posts;
const recentes = rest.slice(0, 9);
---

<Site title="Blog Evolutto — consultoria digital, escala e produtização" description="Estratégia, escala, produtização e os insights da equipe Evolutto para você crescer sua consultoria.">
  <SiteHeader />

  <!-- Hero claro -->
  <section class="relative bg-white border-b border-gray-200 overflow-hidden">
    <div class="absolute top-0 right-0 w-[45%] h-full bg-gradient-to-bl from-evolutto-blue/[0.07] to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-14 lg:py-16">
      <div class="max-w-2xl">
        <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-evolutto-blue">Blog Evolutto</span>
        <h1 class="text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-gray-900 mt-3 mb-4 leading-[1.06]">
          Tendências sobre o universo da <span class="text-evolutto-blue">consultoria</span>.
        </h1>
        <p class="text-lg text-gray-500 mb-8 max-w-xl">Estratégia, escala, produtização e os insights da equipe Evolutto.</p>
        <form action="/blog/buscar" method="get" class="relative max-w-lg">
          <i class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" data-lucide="search"></i>
          <input name="q" type="search" placeholder="Buscar artigos…" autocomplete="off" class="w-full py-3.5 rounded-full bg-[#F3F3F1] border border-gray-200 text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-evolutto-blue/30 focus:border-evolutto-blue transition" style="padding-left:3rem;padding-right:1.25rem" />
        </form>
      </div>
      <div class="flex flex-wrap gap-2 mt-8">
        {cats.map((c) => (
          <a href={`/blog/categoria/${c.slug}`} class="text-xs font-semibold px-3.5 py-1.5 rounded-full bg-[#F3F3F1] border border-gray-200 text-gray-600 hover:bg-evolutto-blue hover:border-evolutto-blue hover:text-white transition-colors">{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <section class="bg-[#F3F3F1] py-14 lg:py-18">
    <div class="max-w-6xl mx-auto px-6">
      {featured && (
        <a href={`/blog/${featured.slug}`} class="blog-featured group mb-14">
          <BlogCover
            title={featured.data.title}
            category={featured.data.category}
            author={featured.data.author}
            minutes={readTime(featured.body)}
            size="featured"
            headingTag="h2"
          />
          <div class="blog-featured__body">
            <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-evolutto-blue mb-3 block">Em destaque</span>
            <p class="text-gray-600 leading-relaxed line-clamp-3 mb-6">{featured.data.description}</p>
            <div class="flex items-center gap-3 text-sm text-gray-500 mb-5">
              <span>{featured.data.author}</span>
              <span class="text-gray-300">·</span>
              <span>{fmtDate(featured.data.pubDate)}</span>
            </div>
            <span class="inline-flex items-center gap-2 text-sm font-bold text-evolutto-blue group-hover:gap-3 transition-all">
              Ler artigo <i class="w-4 h-4" data-lucide="arrow-right"></i>
            </span>
          </div>
        </a>
      )}

      <div class="flex items-end justify-between mb-8">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-gray-900">Mais recentes</h2>
        <a href="/blog/artigos" class="inline-flex items-center gap-2 text-sm font-semibold text-evolutto-blue hover:gap-3 transition-all">Ver todos <i class="w-4 h-4" data-lucide="arrow-right"></i></a>
      </div>
      <div class="blog-grid mb-4">
        {recentes.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <SiteFooter />
</Site>
