---
import type { GetStaticPaths, Page } from 'astro';
import Site from '../../../layouts/Site.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PostCard from '../../../components/PostCard.astro';
import { allPosts, categoriesOf, type Post } from '../../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await allPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const cats = categoriesOf(await allPosts());
---

<Site title={`Artigos${page.currentPage > 1 ? ` — página ${page.currentPage}` : ''} — Blog Evolutto`} description="Biblioteca completa de artigos do blog da Evolutto.">
  <SiteHeader />
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-12 lg:py-14">
      <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-evolutto-blue">Todos os artigos</span>
      <h1 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-gray-900 mt-3 mb-6">Biblioteca completa</h1>
      <div class="flex flex-wrap gap-2">
        {cats.map((c) => (
          <a href={`/blog/categoria/${c.slug}`} class="text-xs font-semibold px-3 py-1.5 rounded-full bg-[#F3F3F1] border border-gray-200 text-gray-600 hover:bg-evolutto-blue hover:border-evolutto-blue hover:text-white transition-colors">{c.name} <span class="text-gray-400">{c.count}</span></a>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-[#F3F3F1] py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-sm text-gray-500 mb-8">Página {page.currentPage} de {page.lastPage} · {page.total} artigos</p>
      <div class="blog-grid">{page.data.map((p) => <PostCard post={p} />)}</div>
      <nav class="flex items-center justify-between mt-14">
        {page.url.prev ? (<a href={page.url.prev} class="inline-flex items-center gap-2 px-5 py-3 rounded-full border border-gray-300 bg-white text-sm font-semibold text-gray-700 hover:border-evolutto-blue hover:text-evolutto-blue transition-colors"><i class="w-4 h-4" data-lucide="arrow-left"></i> Anteriores</a>) : <span></span>}
        {page.url.next ? (<a href={page.url.next} class="inline-flex items-center gap-2 px-5 py-3 rounded-full border border-gray-300 bg-white text-sm font-semibold text-gray-700 hover:border-evolutto-blue hover:text-evolutto-blue transition-colors">Próximos <i class="w-4 h-4" data-lucide="arrow-right"></i></a>) : <span></span>}
      </nav>
    </div>
  </section>
  <SiteFooter />
</Site>
